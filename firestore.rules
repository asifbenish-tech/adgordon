// כללי הגישה ל-Firestore של פרויקט gordon-staff, עבור אפליקציית adgordon.
// מדביקים ב: Firebase console -> Firestore Database -> Rules -> Publish.
// נכנסים רק דרך שרת הכניסה (server/Code.gs), שחותם לכל איש צוות על שם (n) ותפקיד (r).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function signed() { return request.auth != null && request.auth.token.n is string; }
    // חסימה ע"י ההנהלה (off) נכנסת לתוקף מיד, גם במכשיר שכבר מחובר
    function staff() { return signed() && !(exists(me()) && get(me()).data.get('off', false) == true); }
    // התפקיד: מה שההנהלה הגדירה במאגר הצוות (שינוי נכנס לתוקף מיד); עד שהוגדר - מה שהשרת חתם בכניסה
    function role() { return exists(me()) ? get(me()).data.get('role', request.auth.token.get('r', '')) : request.auth.token.get('r', ''); }
    function admin() { return staff() && role() == 'admin'; }
    function inGroup(g) { return exists(me()) && g in get(me()).data.get('groups', []); }

    // מאגר הצוות: כולם קוראים. כל אחד נרשם בעצמו בכניסה הראשונה, בלי קבוצות.
    // קבוצות וחסימה - רק ההנהלה.
    match /staff/{uid} {
      allow read: if staff();
      allow create: if admin() || (staff() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'groups'])
        && request.resource.data.name == request.auth.token.n
        && request.resource.data.groups == []);
      // כל אחד מעדכן לעצמו רק שם מלא וטלפון ("עדכון פרטים"); כל השאר - ההנהלה
      allow update: if admin() || (staff() && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full', 'phone'])
        && request.resource.data.get('full', '') is string && request.resource.data.get('full', '').size() <= 60
        && request.resource.data.get('phone', '') is string && request.resource.data.get('phone', '').size() <= 25);
      allow delete: if admin();
    }
    // תמונת פרופיל: כל אחד מעלה רק את שלו. JPEG קטן כטקסט (אין Cloud Storage בתוכנית החינם).
    match /photos/{uid} {
      allow read: if staff();
      allow create, update: if staff() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['data', 'at'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 90000
        && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
      allow delete: if staff() && (uid == request.auth.uid || admin());
    }
    // פרטי הכניסה (גיבובי ת"ז, מייל, תפקיד): הנהלה בלבד. שרת הכניסה קורא אותם עם חשבון השירות.
    // כל אחד רואה את הרשומה של עצמו ומעדכן בה רק את המייל; ת"ז ותפקיד - רק ההנהלה.
    match /staffAuth/{uid} {
      allow read, write: if admin();
      allow get: if staff() && uid == request.auth.uid;
      allow update: if staff() && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 100;
    }
    // רישום להתראות: כל אחד רואה ומעדכן רק את שלו (אסימוני המכשירים + השמירות שלו). ההנהלה יכולה למחוק.
    match /push/{uid} {
      allow read, create, update: if staff() && uid == request.auth.uid;
      allow delete: if staff() && (uid == request.auth.uid || admin());
    }
    // אישור הגעה לשמירה: כל אחד מאשר רק לעצמו (ואי אפשר לשנות או למחוק). רואים: הוא עצמו, ההנהלה ואחראי הביטחון (sec).
    match /checkins/{id} {
      allow read: if staff() && (resource.data.uid == request.auth.uid || admin() || inGroup('sec'));
      allow create: if staff() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'date', 'from', 'to', 'place', 'at'])
        && request.resource.data.date is string && request.resource.data.from is string
        && id == request.resource.data.date + '_' + request.auth.uid + '_' + request.resource.data.from;
    }
    match /meta/{id}   { allow read: if staff(); allow write: if admin(); }
    match /duties/{id} { allow read: if staff(); allow write: if admin(); }
    match /events/{id} { allow read: if staff(); allow write: if admin(); }

    // לוח ההודעות: ערוץ לכל קהל יעד. all = כולם; מזהה קבוצה = חברי הקבוצה; s_<uid> = העותק של השולח.
    // ההנהלה רואה את ערוצי הקבוצות; כל איש צוות יכול לשלוח לכל קהל.
    // יוצא מן הכלל: mgmt = תיבת צוות הניהול. קוראים וכותבים בה רק חברי הקבוצה, גם לא שאר ההנהלה.
    match /channels/{ch}/msgs/{id} {
      allow read: if staff() && (ch == 'mgmt' ? inGroup('mgmt') : (ch == 'all' || ch == 's_' + request.auth.uid || admin() || inGroup(ch)));
      allow create: if staff() && request.resource.data.by == request.auth.uid
        && (ch != 'mgmt' || inGroup('mgmt'))
        && (ch.size() < 2 || ch[0:2] != 's_' || ch == 's_' + request.auth.uid);
      allow delete: if staff() && (ch != 'mgmt' || inGroup('mgmt')) && (resource.data.by == request.auth.uid || admin());
    }

    // שיחות פרטיות: רק שני המשתתפים. גם ההנהלה לא קוראת.
    match /chats/{cid} {
      allow read: if staff() && request.auth.uid in resource.data.members;
      allow create: if staff() && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && cid == request.resource.data.members[0] + '__' + request.resource.data.members[1];
      allow update: if staff() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      match /msgs/{id} {
        allow read: if staff() && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
        allow create: if staff() && request.resource.data.by == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
      }
    }
  }
}
