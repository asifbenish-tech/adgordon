// כללי הגישה ל-Firestore של פרויקט gordon-staff, עבור אפליקציית adgordon.
// מדביקים ב: Firebase console -> Firestore Database -> Rules -> Publish.
// נכנסים רק דרך שרת הכניסה (server/Code.gs), שחותם לכל איש צוות על שם (n) ותפקיד (r).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function signed() { return request.auth != null && request.auth.token.n is string; }
    // חסימה ע"י ההנהלה (off) נכנסת לתוקף מיד, גם במכשיר שכבר מחובר
    function staff() { return signed() && !(exists(me()) && get(me()).data.get('off', false) == true); }
    // התפקיד: מה שההנהלה הגדירה במאגר הצוות (שינוי נכנס לתוקף מיד); עד שהוגדר - מה שהשרת חתם בכניסה
    function role() { return exists(me()) ? get(me()).data.get('role', request.auth.token.get('r', '')) : request.auth.token.get('r', ''); }
    function admin() { return staff() && role() == 'admin'; }
    function inGroup(g) { return exists(me()) && g in get(me()).data.get('groups', []); }

    // מאגר הצוות: כולם קוראים. כל אחד נרשם בעצמו בכניסה הראשונה, בלי קבוצות.
    // קבוצות וחסימה - רק ההנהלה.
    match /staff/{uid} {
      allow read: if staff();
      allow create: if admin() || (staff() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'groups'])
        && request.resource.data.name == request.auth.token.n
        && request.resource.data.groups == []);
      // כל אחד מעדכן לעצמו רק שם מלא וטלפון ("עדכון פרטים"); כל השאר - ההנהלה
      allow update: if admin() || (staff() && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full', 'phone'])
        && request.resource.data.get('full', '') is string && request.resource.data.get('full', '').size() <= 60
        && request.resource.data.get('phone', '') is string && request.resource.data.get('phone', '').size() <= 25);
      allow delete: if admin();
    }
    // תמונת פרופיל: כל אחד מעלה רק את שלו. JPEG קטן כטקסט (אין Cloud Storage בתוכנית החינם).
    match /photos/{uid} {
      allow read: if staff();
      allow create, update: if staff() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['data', 'at'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 90000
        && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
      allow delete: if staff() && (uid == request.auth.uid || admin());
    }
    // פרטי הכניסה (גיבובי ת"ז, מייל, תפקיד): הנהלה בלבד. שרת הכניסה קורא אותם עם חשבון השירות.
    // כל אחד רואה את הרשומה של עצמו ומעדכן בה רק את המייל; ת"ז ותפקיד - רק ההנהלה.
    match /staffAuth/{uid} {
      allow read, write: if admin();
      allow get: if staff() && uid == request.auth.uid;
      allow update: if staff() && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 100;
    }
    // רישום להתראות: כל אחד רואה ומעדכן רק את שלו (אסימוני המכשירים + השמירות שלו). ההנהלה יכולה למחוק.
    match /push/{uid} {
      allow read, create, update: if staff() && uid == request.auth.uid;
      allow delete: if staff() && (uid == request.auth.uid || admin());
    }
    // אישור הגעה לשמירה: כל אחד מאשר רק לעצמו (ואי אפשר לשנות או למחוק). רואים: הוא עצמו, ההנהלה ואחראי הביטחון (sec).
    match /checkins/{id} {
      allow read: if staff() && (resource.data.uid == request.auth.uid || admin() || inGroup('sec'));
      allow create: if staff() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'date', 'from', 'to', 'place', 'at'])
        && request.resource.data.date is string && request.resource.data.from is string
        && id == request.resource.data.date + '_' + request.auth.uid + '_' + request.resource.data.from;
    }
    // סידור ישיבה: כל איש צוות שומר את הכיתות שלו. רק הוא קורא וכותב - יש בהן שמות תלמידים, ולכן גם לא ההנהלה.
    match /seating/{uid}/classes/{cid} {
      allow read, delete: if staff() && uid == request.auth.uid;
      allow create, update: if staff() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['className', 'teacher', 'students', 'layout', 'room', 'seats', 'nameMode', 'nameOrder', 'updated'])
        && request.resource.data.students is list && request.resource.data.students.size() <= 80
        && request.resource.data.seats is list && request.resource.data.seats.size() <= 200
        && request.resource.data.className is string && request.resource.data.className.size() <= 60
        && (!('room' in request.resource.data) || request.resource.data.room.items.size() <= 40);
    }
    // סידור חדר האוכל: כל מחנך שומר את הכיתות שלו (כולל הנוכחות וההיסטוריה). רק הוא קורא וכותב - גם לא ההנהלה.
    match /dining/{uid}/classes/{cid} {
      allow read, delete: if staff() && uid == request.auth.uid;
      allow create, update: if staff() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'students', 'columns', 'teams', 'tables', 'roles', 'opts', 'today', 'hist', 'updated'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.students is list && request.resource.data.students.size() <= 80
        && request.resource.data.columns is list && request.resource.data.columns.size() <= 6
        && request.resource.data.teams is list && request.resource.data.teams.size() <= 12
        && request.resource.data.roles is list && request.resource.data.roles.size() <= 20
        && (!('hist' in request.resource.data) || request.resource.data.hist.size() <= 400);
    }
    // הודעה קופצת: כל נמען מאשר שקרא (רק בשם עצמו). רואים את הרשימה: הוא עצמו, ההנהלה וצוות הניהול.
    match /popreads/{mid}/u/{uid} {
      allow read: if staff() && (uid == request.auth.uid || admin() || inGroup('mgmt'));
      allow create, update: if staff() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['at', 'name']);
    }
    // מערכת השינויים היומית: כולם רואים; מעלים/מחליפים/מוחקים הנהלה וצוות ניהול. JPEG קטן כטקסט (מסמך עד 1MB).
    match /daily/{date} {
      allow read: if staff();
      allow create, update: if staff() && (admin() || inGroup('mgmt')) && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000
        && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.by == request.auth.uid;
      allow delete: if staff() && (admin() || inGroup('mgmt'));
    }
    // השינויים במערכת מניהול גורדון: רק שרת הכניסה כותב (חשבון שירות, עוקף את הכללים)
    match /changes/{date} { allow read: if staff(); allow write: if false; }
    match /meta/{id}   { allow read: if staff(); allow write: if admin(); }
    match /duties/{id} { allow read: if staff(); allow write: if admin(); }
    match /events/{id} { allow read: if staff(); allow write: if admin(); }

    // לוח ההודעות: ערוץ לכל קהל יעד. all = כולם; מזהה קבוצה = חברי הקבוצה; s_<uid> = העותק של השולח.
    // ההנהלה רואה את ערוצי הקבוצות; כל איש צוות יכול לשלוח לכל קהל.
    // יוצא מן הכלל: mgmt = תיבת צוות הניהול. קוראים וכותבים בה רק חברי הקבוצה, גם לא שאר ההנהלה.
    match /channels/{ch}/msgs/{id} {
      allow read: if staff() && (ch == 'mgmt' ? inGroup('mgmt') : (ch == 'all' || ch == 's_' + request.auth.uid || admin() || inGroup(ch)));
      allow create: if staff() && request.resource.data.by == request.auth.uid
        && (ch != 'mgmt' || inGroup('mgmt'))
        && ((request.resource.data.get('pop', false) != true && request.resource.data.get('notice', false) != true) || admin() || inGroup('mgmt'))
        && (ch.size() < 2 || ch[0:2] != 's_' || ch == 's_' + request.auth.uid);
      allow delete: if staff() && (ch != 'mgmt' || inGroup('mgmt')) && (resource.data.by == request.auth.uid || admin());
    }

    // שיחות: רק המשתתפים קוראים (גם ההנהלה לא קוראת שיחה שהיא לא בה).
    //   פרטית: chats/<uidA__uidB>, בדיוק שני משתתפים.
    //   קבוצה: chats/g_<id> - כל איש צוות פותח (ונהיה מנהל הקבוצה); מנהלי הקבוצה משנים שם ומשתתפים; כל אחד יכול לצאת.
    //   קבוצה קבועה: chats/sys_<key> (לוח בית חינוך, בתים, מחנכים, צוות ניהול, שכבות) - רק ההנהלה כותבת את המשתתפים.
    //   כל משתתף מעדכן את "ההודעה האחרונה" (last).
    match /chats/{cid} {
      function d() { return request.resource.data; }
      function was() { return resource.data; }
      function changed() { return d().diff(was()).affectedKeys(); }
      allow read: if staff() && request.auth.uid in resource.data.members;
      allow create: if staff() && !cid.matches('^(g|sys)_.*') && request.auth.uid in d().members
        && d().members.size() == 2
        && cid == d().members[0] + '__' + d().members[1];
      allow create: if staff() && cid.matches('^g_[A-Za-z0-9]{4,30}$') && d().type == 'group' && d().get('sys', false) == false
        && d().name is string && d().name.size() > 0 && d().name.size() <= 60
        && request.auth.uid in d().members && d().members.size() <= 400 && d().admins == [request.auth.uid];
      allow create, update: if admin() && cid.matches('^sys_[A-Za-z0-9_]{1,40}$') && d().sys == true && d().type == 'group';
      // פרטית: המשתתפים לא משתנים
      allow update: if staff() && !cid.matches('^(g|sys)_.*') && request.auth.uid in was().members && d().members == was().members;
      // קבוצה: כל משתתף - רק ההודעה האחרונה
      allow update: if staff() && cid.matches('^(g|sys)_.*') && request.auth.uid in was().members && changed().hasOnly(['last']);
      // קבוצה פתוחה: מנהל הקבוצה משנה שם / משתתפים / מנהלים
      allow update: if staff() && cid.matches('^g_.*') && request.auth.uid in was().get('admins', [])
        && changed().hasOnly(['name', 'members', 'admins', 'last']) && d().name is string && d().name.size() > 0 && d().name.size() <= 60
        && d().members.size() <= 400 && d().get('sys', false) == false;
      // יציאה מקבוצה פתוחה: רק להוריד את עצמי
      allow update: if staff() && cid.matches('^g_.*') && request.auth.uid in was().members
        && changed().hasOnly(['members', 'admins'])
        && d().members == was().members.removeAll([request.auth.uid])
        && d().admins.toSet().difference(was().get('admins', []).toSet()).size() <= 1;
      match /msgs/{id} {
        allow read: if staff() && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
        allow create: if staff() && request.resource.data.by == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
      }
    }
  }
}
